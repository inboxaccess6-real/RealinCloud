@inject AdminAuthStateProvider AuthStateProvider
@inject AuthService AuthService
@inject NavigationManager Navigation

<header class="topbar">
    <div class="topbar-left">
        <button class="topbar-toggle desktop-only" @onclick="OnToggleSidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        <button class="topbar-toggle mobile-only" @onclick="OnToggleMobileSidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
    </div>

    <div class="topbar-right">
        <div class="topbar-user" @onclick="ToggleDropdown">
            <div class="topbar-avatar">@GetInitials()</div>
            <div class="topbar-user-info">
                <span class="topbar-user-name">@(AuthStateProvider.CurrentUser?.Name ?? "User")</span>
                <span class="topbar-user-role">@(AuthStateProvider.CurrentUser?.Role ?? "")</span>
            </div>
        </div>
    </div>

    @if (showDropdown)
    {
        <div class="user-dropdown">
            <div class="user-dropdown-item" @onclick="() => showDropdown = false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
                Profile
            </div>
            <div class="user-dropdown-divider"></div>
            <button class="user-dropdown-item danger" @onclick="HandleLogout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Logout
            </button>
        </div>
    }
</header>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnToggleMobileSidebar { get; set; }

    private bool showDropdown = false;

    private void ToggleDropdown() => showDropdown = !showDropdown;

    private string GetInitials()
    {
        var name = AuthStateProvider.CurrentUser?.Name;
        if (string.IsNullOrEmpty(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : $"{parts[0][0]}".ToUpper();
    }

    private async Task HandleLogout()
    {
        showDropdown = false;
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
