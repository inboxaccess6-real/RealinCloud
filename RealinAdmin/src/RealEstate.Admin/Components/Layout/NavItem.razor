@inject NavigationManager Navigation

<a href="@Href" class="nav-item @(IsActive ? "active" : "")" @onclick="OnClick" @onclick:preventDefault>
    <span class="nav-item-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            @((MarkupString)GetIconPath())
        </svg>
    </span>
    <span class="nav-item-label">@Label</span>
    @if (BadgeCount > 0)
    {
        <span class="nav-item-badge">@BadgeCount</span>
    }
</a>

@code {
    [Parameter] public string Href { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int BadgeCount { get; set; } = 0;

    private bool IsActive => Navigation.Uri.Contains(Href, StringComparison.OrdinalIgnoreCase)
        && (Href == "/dashboard" ? Navigation.Uri.TrimEnd('/').EndsWith("/dashboard", StringComparison.OrdinalIgnoreCase) || Navigation.Uri.TrimEnd('/').EndsWith(Navigation.BaseUri.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) : true);

    private void OnClick()
    {
        Navigation.NavigateTo(Href);
    }

    private string GetIconPath() => Icon switch
    {
        "dashboard" => "<rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/>",
        "users" => "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/>",
        "shield" => "<path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/>",
        "building" => "<rect x='4' y='2' width='16' height='20' rx='2' ry='2'/><path d='M9 22v-4h6v4'/><path d='M8 6h.01'/><path d='M16 6h.01'/><path d='M12 6h.01'/><path d='M12 10h.01'/><path d='M12 14h.01'/><path d='M16 10h.01'/><path d='M16 14h.01'/><path d='M8 10h.01'/><path d='M8 14h.01'/>",
        "hardhat" => "<path d='M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2z'/><path d='M10 15V6a2 2 0 0 1 2-2v0a2 2 0 0 1 2 2v9'/><path d='M4 15v-3a6 6 0 0 1 6-6h0'/><path d='M14 6h0a6 6 0 0 1 6 6v3'/>",
