@if (IsLoading)
{
    if (Overlay)
    {
        <div class="loading-overlay">
            <div>
                <div class="spinner"></div>
                @if (!string.IsNullOrEmpty(Text))
                {
                    <p>@Text</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="spinner"></div>
        @if (!string.IsNullOrEmpty(Text))
        {
            <p>@Text</p>
        }
    }
}

@code {
    [Parameter]
    public bool IsLoading { get; set; } = true;

    [Parameter]
    public bool Overlay { get; set; }

    [Parameter]
    public string? Text { get; set; }
}
