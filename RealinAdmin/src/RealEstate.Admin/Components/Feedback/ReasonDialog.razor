@if (_isVisible)
{
    <div class="modal-backdrop" @onclick="Hide">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@Title</h3>
            </div>
            <div class="modal-body">
                <p>@Message</p>
                <div style="margin-top: 1rem;">
                    <label style="display: block; font-size: 0.85em; color: var(--color-text-muted, #64748b); margin-bottom: 0.5rem; font-weight: 600;">
                        @ReasonLabel
                    </label>
                    <textarea @bind="_reason"
                              rows="4"
                              style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border, #e2e8f0); border-radius: 6px; font-size: var(--font-size-sm); resize: vertical; font-family: inherit;"
                              placeholder="@ReasonLabel..."></textarea>
                    @if (_showValidation && string.IsNullOrWhiteSpace(_reason))
                    {
                        <div style="color: var(--color-danger, #ef4444); font-size: 0.85em; margin-top: 0.25rem;">
                            Reason is required.
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HandleCancel">@CancelText</button>
                <button class="@ConfirmCssClass" @onclick="HandleConfirm">@ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string ReasonLabel { get; set; } = "Reason";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    [Parameter]
    public string ConfirmCssClass { get; set; } = "btn btn-danger";

    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool _isVisible;
    private string _reason = "";
    private bool _showValidation;

    public void Show()
    {
        _isVisible = true;
        _reason = "";
        _showValidation = false;
        StateHasChanged();
    }

    public void Hide()
    {
        _isVisible = false;
        _reason = "";
        _showValidation = false;
        StateHasChanged();
    }

    private async Task HandleConfirm()
    {
        _showValidation = true;
        if (string.IsNullOrWhiteSpace(_reason))
        {
            StateHasChanged();
            return;
        }

        var reason = _reason.Trim();
        Hide();
        await OnConfirm.InvokeAsync(reason);
    }

    private async Task HandleCancel()
    {
        Hide();
        await OnCancel.InvokeAsync();
    }
}
