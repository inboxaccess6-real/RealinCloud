@typeparam TItem

<div class="data-table-wrapper">
    @if (Searchable)
    {
        <div class="data-table-toolbar">
            <div class="search-input-wrapper">
                <input type="text"
                       class="search-input"
                       placeholder="Search..."
                       @bind="_searchTerm"
                       @bind:event="oninput"
                       @bind:after="OnSearchInput" />
            </div>
        </div>
    }

    <div style="position: relative;">
        @if (_isLoading)
        {
            <div class="loading-overlay">
                <div class="spinner"></div>
            </div>
        }

        @if (_items is not null && _items.Count > 0)
        {
            <table class="data-table">
                <thead>
                    <tr>
                        @foreach (var column in Columns)
                        {
                            <th style="@(column.Width is not null ? $"width: {column.Width}" : "")">
                                @column.Header
                            </th>
                        }
                        @if (ActionTemplate is not null)
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            @foreach (var column in Columns)
                            {
                                <td class="@column.CssClass">
                                    @if (column.Template is not null)
                                    {
                                        @column.Template(item)
                                    }
                                    else
                                    {
                                        @column.ValueSelector(item)
                                    }
                                </td>
                            }
                            @if (ActionTemplate is not null)
                            {
                                <td>
                                    @ActionTemplate(item)
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (!_isLoading)
        {
            <EmptyState Title="@EmptyMessage" />
        }
    </div>

    @if (_totalCount > 0)
    {
        <div class="data-table-footer">
            <Pagination Page="_currentPage"
                        TotalPages="_totalPages"
                        PageSize="_pageSize"
                        TotalCount="_totalCount"
                        OnPageChanged="OnPageChanged" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<DataColumn<TItem>> Columns { get; set; } = new();

    [Parameter, EditorRequired]
    public Func<int, int, string?, Task<(List<TItem> Items, int TotalCount)>> LoadData { get; set; } = default!;

    [Parameter]
    public RenderFragment<TItem>? ActionTemplate { get; set; }

    [Parameter]
    public bool Searchable { get; set; } = true;

    [Parameter]
    public int DefaultPageSize { get; set; } = 20;

    [Parameter]
    public string? EmptyMessage { get; set; } = "No records found.";

    private List<TItem>? _items;
    private int _currentPage = 1;
    private int _pageSize;
    private int _totalCount;
    private int _totalPages;
    private string? _searchTerm;
    private bool _isLoading;
    private Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        _pageSize = DefaultPageSize;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await LoadData(_currentPage, _pageSize, _searchTerm);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = (int)Math.Ceiling((double)_totalCount / _pageSize);
        }
        catch
        {
            _items = new List<TItem>();
            _totalCount = 0;
            _totalPages = 0;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchInput()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(async _ =>
        {
            _currentPage = 1;
            await InvokeAsync(LoadDataAsync);
        }, null, 300, Timeout.Infinite);
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadDataAsync();
    }

    public async Task RefreshAsync()
    {
        _currentPage = 1;
        _searchTerm = null;
        await LoadDataAsync();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
