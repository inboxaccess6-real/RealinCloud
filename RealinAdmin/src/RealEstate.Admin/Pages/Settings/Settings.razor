@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="page-header">
    <h1 class="page-title">Settings</h1>
</div>

<!-- System Settings -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
        <h3 style="font-size: var(--font-size-base); font-weight: var(--font-weight-semibold);">System Settings</h3>
    </div>
    <div class="card-body">
        <div class="empty-state" style="padding: var(--space-6);">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                 stroke="var(--color-text-muted, #94a3b8)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                 style="margin-bottom: 1rem;">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
            <div class="empty-state-description">
                System-wide configuration such as default currency, timezone, and application preferences will be available here.
            </div>
            <span class="badge badge-default" style="margin-top: 0.75rem;">Coming Soon</span>
        </div>
    </div>
</div>

<!-- Notification Rules -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
        <h3 style="font-size: var(--font-size-base); font-weight: var(--font-weight-semibold);">Notification Rules</h3>
    </div>
    <div class="card-body">
        <div class="empty-state" style="padding: var(--space-6);">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                 stroke="var(--color-text-muted, #94a3b8)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                 style="margin-bottom: 1rem;">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <div class="empty-state-description">
                Configure email and push notification triggers for property approvals, new submissions, and system alerts.
            </div>
            <span class="badge badge-default" style="margin-top: 0.75rem;">Coming Soon</span>
        </div>
    </div>
</div>

<!-- Feature Flags -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
        <h3 style="font-size: var(--font-size-base); font-weight: var(--font-weight-semibold);">Feature Flags</h3>
    </div>
    <div class="card-body">
        <div class="empty-state" style="padding: var(--space-6);">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                 stroke="var(--color-text-muted, #94a3b8)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                 style="margin-bottom: 1rem;">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                <line x1="4" y1="22" x2="4" y2="15"/>
            </svg>
            <div class="empty-state-description">
                Toggle experimental features on or off across the platform without deployments.
            </div>
            <span class="badge badge-default" style="margin-top: 0.75rem;">Future</span>
        </div>
    </div>
</div>
