{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SearchPath=realin"
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "RealinApi",
    "Audience": "RealinApp",
    "AccessTokenExpirationMinutes": "60"
  },
  "OAuth": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID"
    },
    "Apple": {
      "ClientId": "YOUR_APPLE_CLIENT_ID"
    }
  },
  "Otp": {
    "ExpirationMinutes": "10",
    "MaxAttemptsPerWindow": "5",
    "RateLimitWindowMinutes": "60",
    "Length": "6"
  }
}
