{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "AccessTokenExpirationMinutes": "60"
  },
  "Otp": {
    "ExpirationMinutes": "10",
    "MaxAttemptsPerWindow": "5",
    "RateLimitWindowMinutes": "60",
    "Length": "6"
  }
}
